# ---------------------------------------------------------------------------
# Verity landing page configuration (all optional for local development)
# Copy to .env.local. The site is fully static: values are inlined at BUILD
# time, so set them before `npm run build`.
# ---------------------------------------------------------------------------

# Production origin, no trailing slash. Drives canonical URLs, Open Graph,
# sitemap and robots.txt. While unset, the page sends `noindex` and robots.txt
# disallows all crawling, so preview deployments stay out of search engines.
NEXT_PUBLIC_SITE_URL=

# Public inbox. When set, the page shows a "Notify me at launch" button that
# opens the visitor's email app, plus a Contact link in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional sub-path to serve the site under, no trailing slash. For example
# "/verity" puts the page at https://your-domain/verity/ and the Privacy Policy
# at https://your-domain/verity/privacy-policy. Leave empty to serve at the root.
NEXT_PUBLIC_BASE_PATH=

# Privacy inbox shown in the Privacy Policy. Falls back to CONTACT_EMAIL.
NEXT_PUBLIC_PRIVACY_EMAIL=
